* {{ font-family: "Segoe UI Variable", "Segoe UI"; font-size: 14px; color: {text_primary}; }}
QWidget#root {{ background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #09110e,stop:1 #0c1512); border: 1px solid #263a31; border-radius: 16px; }}
QFrame#panel, QFrame#progressPanel, QFrame#dropZone {{ background: {panel}; border: 1px solid {border}; border-radius: 16px; }}
QFrame#sourcePanel {{ background: #0e1713; border: 1px solid {border}; border-radius: 16px; }}
QFrame#textEditorPanel, QFrame#referencePanel {{ background: #101713; border: 1px solid {border}; border-radius: 14px; }}
QFrame#exampleCard {{ background: #141d18; border: 0; border-radius: 9px; }}
QFrame#changelogCard {{ background: #101a15; border: 1px solid {border}; border-radius: 12px; }}
QFrame#divider {{ background: #2a4035; border: 0; }}
QLabel#secondary, QLabel#caption {{ color: {text_secondary}; }}
QLabel#heading {{ font-size: 18px; font-weight: 650; }}
QLabel#progressStatus {{ color: #9eb3a8; font-size: 13px; }}
QLabel#progressCaption {{ color: #8fa198; font-size: 13px; padding-top: 3px; }}
QLabel#progressValue {{ color: #f3f8f5; font-size: 15px; font-weight: 550; padding-top: 2px; }}
QLabel#chip {{ background: #202923; border-radius: 13px; padding: 6px 11px; color: #d9e3dd; }}
QLabel#dictionaryWord {{ font-size: 16px; font-weight: 650; color: #f2f7f4; padding: 5px 0; }}
QLabel#changelogTitle {{ color: #51dc88; font-size: 16px; font-weight: 700; padding-bottom: 5px; }}
QLabel#definition, QLabel#relatedWords {{ color: #d9b94f; background: #201e12; border-radius: 8px; padding: 7px 9px; }}
QLabel#brandTitle {{ font-size: 16px; font-weight: 700; }}
QLabel#brandTeam {{ font-size: 9px; letter-spacing: 2px; color: {text_secondary}; }}
QPushButton {{ background: #19231e; border: 1px solid {border}; border-radius: 9px; padding: 9px 14px; }}
QPushButton:hover {{ background: {panel_hover}; border-color: #385044; }}
QPushButton:pressed {{ background: #101713; }}
QPushButton:disabled {{ color: #59665f; background: #121713; }}
QPushButton#primary {{ background: {accent_green}; border-color: {accent_green}; color: white; font-weight: 650; padding: 13px 20px; }}
QPushButton#primary:hover {{ background: #20b960; }}
QPushButton#outlinePrimary {{ color: white; background: #102018; border: 1px solid {accent_green}; font-weight: 650; }}
QPushButton#outlinePrimary:hover {{ background: #143222; }}
QPushButton#iconButton {{ background: transparent; border: 0; padding: 3px; }}
QToolButton#infoButton {{ background: transparent; border: 0; border-radius: 6px; padding: 3px; }}
QToolButton#infoButton:hover {{ background: #1a2a21; }}
QPushButton#aboutProjectLink {{ background: transparent; border: 0; color: {text_primary}; font-size: 25px; font-weight: 700; padding: 2px; }}
QPushButton#aboutProjectLink:hover {{ color: {accent_green}; background: transparent; }}
QPushButton#danger:hover {{ color: white; background: #7c3037; border-color: {danger_red}; }}
QPushButton#windowButton {{ background: transparent; border: 0; border-radius: 6px; padding: 0; }}
QPushButton#windowButton:hover {{ background: #202923; }}
QPushButton#closeButton {{ background: transparent; border: 0; border-radius: 6px; padding: 0; }}
QPushButton#closeButton:hover {{ background: #c42b3a; }}
QPushButton#navTab {{ background: #0d1512; border: 1px solid {border}; border-radius: 12px; color: {text_secondary}; padding: 11px 22px; min-width: 170px; }}
QPushButton#navTab:checked {{ background: #10271b; border-color: {accent_green}; color: white; }}
QComboBox {{ background: #101713; border: 1px solid {border}; border-radius: 9px; padding: 9px 12px; min-height: 20px; }}
QComboBox:hover {{ border-color: #416151; }}
QComboBox::drop-down {{ border: 0; width: 24px; }}
QComboBox QAbstractItemView {{ background: #162019; border: 1px solid {border}; selection-background-color: #23653e; outline: 0; }}
QTextEdit {{ background: #0f1612; border: 1px solid {border}; border-radius: 12px; padding: 12px; selection-background-color: #237544; }}
QLineEdit {{ background: #0f1612; border: 1px solid {border}; border-radius: 9px; padding: 9px 12px; selection-background-color: #237544; }}
QLineEdit:focus, QComboBox:focus {{ border-color: {accent_green}; }}
QCheckBox {{ spacing: 9px; padding: 3px 0; }}
QCheckBox::indicator {{ width: 17px; height: 17px; border: 1px solid #526359; border-radius: 5px; background: #0f1612; }}
QCheckBox::indicator:checked {{ background: {accent_green}; border-color: {accent_green}; }}
QScrollArea {{ background: transparent; border: 0; }}
QScrollArea > QWidget > QWidget {{ background: transparent; }}
QScrollBar:vertical {{ background: transparent; width: 9px; margin: 2px; }}
QScrollBar::handle:vertical {{ background: #35463d; border-radius: 4px; min-height: 30px; }}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0; }}
QTreeWidget {{ background: transparent; border: 0; outline: 0; alternate-background-color: #111914; }}
QTreeWidget::item {{ min-height: 28px; border-radius: 5px; }}
QTreeWidget::item:hover {{ background: #1a2620; }}
QTreeWidget::item:selected {{ background: #23573a; }}
QTableView {{ background: #101713; border: 1px solid {border}; border-radius: 8px; gridline-color: {border}; outline: 0; }}
QTableView::item {{ padding: 7px 10px; border-bottom: 1px solid #1c2922; }}
QTableView::item:hover {{ background: #1a2820; }}
QTableView::item:selected {{ background: #235f3a; color: white; }}
QHeaderView::section {{ background: #0c120f; color: {text_primary}; border: 0; border-bottom: 1px solid {border}; padding: 8px 10px; font-weight: 650; }}
QProgressBar {{ background: #0c120f; border: 0; border-radius: 5px; height: 10px; text-align: center; color: transparent; }}
QProgressBar::chunk {{ background: {accent_green}; border-radius: 5px; }}
QRadioButton {{ spacing: 7px; }}
QRadioButton::indicator {{ width: 20px; height: 20px; }}
QRadioButton::indicator:unchecked {{ image: url(C:/TreeTranslate/assets/icons/radio_unchecked.svg); }}
QRadioButton::indicator:checked {{ image: url(C:/TreeTranslate/assets/icons/radio_checked.svg); }}
QDialog {{ background: {background}; }}
QMenu {{ background: #111a16; border: 1px solid #315040; border-radius: 10px; padding: 6px; }}
QMenu::item {{ min-height: 28px; padding: 7px 14px 7px 12px; border-radius: 7px; }}
QMenu::item:selected {{ background: #174c2c; color: white; }}
QMenu::icon {{ padding-left: 8px; }}
QMenu::separator {{ height: 1px; background: {border}; margin: 5px 9px; }}
QListWidget {{ background: transparent; border: 0; outline: 0; }}
QListWidget::item {{ padding: 10px; border-radius: 8px; }}
QListWidget::item:selected {{ background: #1d5e37; }}
QListWidget#settingsNav {{ background: #101713; border: 1px solid {border}; border-radius: 12px; padding: 6px; }}
QListWidget#settingsNav::item {{ margin: 2px; padding: 12px; }}
QToolTip {{ background: #18231d; color: #eef6f1; border: 1px solid #3d5a4b; border-radius: 7px; padding: 9px; }}
